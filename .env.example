# Copy to .env.local and fill in. Everything is optional.

# Public URL of your site (used for SEO, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form via Resend (https://resend.com). Without a key the form falls back to mailto:.
RESEND_API_KEY=
